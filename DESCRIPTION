Package: uxlearn
Type: Package
Title: Tools for Learning User Experience
Version: 0.1.0
Authors@R:
    person(
      "Pablo", "Sánchez-Núñez",
      email = "psancheznunez@outlook.com",
      role = c("aut", "cre", "cph"),
      comment = c(ORCID = "0000-0001-7845-9506")
